# ===== Thư viện =====
node_modules/

# ===== Biến môi trường (chứa mật khẩu DB, JWT secret, PASSWORD_SALT) =====
.env
.env.*
!.env.example
!.env.test.example

# ===== Frontend (Next.js) =====
frontend/.next/
frontend/out/
frontend/build/
frontend/next-env.d.ts
frontend/.swc/
.vercel/

# ===== Backend (NestJS + Prisma) =====
backend/dist/
backend/src/generated/
backend/uploads/
# File dữ liệu thử (Prisma Studio / SQLite tạm) — DB thật nằm trong volume Docker
*.db
*.db-journal
*.sqlite
*.sqlite3

# ===== Docker (dữ liệu bind-mount cục bộ, nếu có) =====
docker/mysql/data/

# ===== Build cache =====
*.tsbuildinfo
.eslintcache
.turbo/
.cache/
.npm/
.parcel-cache/

# ===== Kiểm thử =====
coverage/
test-results/
junit.xml

# ===== Log =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Khóa / chứng chỉ (không bao giờ commit) =====
*.pem
*.key
*.p12
*.pfx
*.crt

# ===== Hệ điều hành =====
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ===== Editor / IDE =====
.vs/
.idea/
# Chỉ chia sẻ gợi ý extension; settings.json là cấu hình cá nhân → KHÔNG commit
.vscode/*
!.vscode/extensions.json
*.code-workspace
.history/
*.swp
*.swo
*~

# ===== File thừa sau khi giải quyết merge conflict / patch =====
*.orig
*.rej

# ===== Claude Code =====
# settings.json và .mcp.json dùng chung cho cả nhóm → CÓ commit
# settings.local.json là cấu hình cá nhân → KHÔNG commit
.claude/settings.local.json
.claude/worktrees/

# ===== File tạm của Office (báo cáo .docx đang mở) =====
~$*.docx
~$*.xlsx
~$*.pptx
