enum PromotionType {
  FIXED
  PERCENT
}

model Promotion {
  id          String        @id @default(uuid()) @map("promotion_id") @db.Char(36)
  code        String        @unique @db.VarChar(32)
  name        String        @db.VarChar(150)
  type        PromotionType
  value       Decimal       @db.Decimal(12, 0)
  minSubtotal Decimal       @default(0) @map("min_subtotal") @db.Decimal(16, 0)
  maxDiscount Decimal?      @map("max_discount") @db.Decimal(12, 0)
  startsAt    DateTime      @map("starts_at") @db.DateTime(3)
  endsAt      DateTime      @map("ends_at") @db.DateTime(3)
  active      Boolean       @default(true)

  @@index([active, startsAt, endsAt])
  @@map("promotion")
}
