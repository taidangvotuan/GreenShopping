// =====================================================================
// Miền 1 — Auth & User (Thành viên A)
// Khớp ERD: User, Role, UserRole, Permission, RolePermission, Address, AuditLog
// File mẫu để cả nhóm theo cùng quy ước khi viết các file miền khác.
// GreenPointAccount (1-1 với User) khai báo ở green-coins.prisma.
// =====================================================================

// status lưu VARCHAR(30) theo ERD (không dùng ENUM của MySQL).
// Giá trị hợp lệ: ACTIVE | INACTIVE | LOCKED | PENDING
// → kiểm soát ở tầng ứng dụng: src/modules/auth-user/auth/auth.constants.ts
model User {
  id           String    @id @default(uuid()) @map("user_id") @db.Char(36)
  fullName     String    @map("full_name") @db.VarChar(150)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  status       String    @default("ACTIVE") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  roles             UserRole[]
  addresses         Address[]
  greenPointAccount GreenPointAccount?
  auditLogs         AuditLog[]

  // Index thường (không UNIQUE theo ERD) để tra cứu nhanh khi đăng nhập bằng SĐT
  @@index([phone])
  @@map("user")
}

// Role là BẢNG, không phải enum — Admin có thể thêm mô tả.
// Giá trị name được seed sẵn: CUSTOMER, SELLER, STAFF, ADMIN.
model Role {
  id          String  @id @default(uuid()) @map("role_id") @db.Char(36)
  name        String  @unique @db.VarChar(30)
  description String? @db.Text

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model UserRole {
  userId     String   @map("user_id") @db.Char(36)
  roleId     String   @map("role_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// permission_code dạng "<resource>:<action>", ví dụ "product:create"
model Permission {
  id             String   @id @default(uuid()) @map("permission_id") @db.Char(36)
  permissionCode String   @unique @map("permission_code") @db.VarChar(100)
  name           String   @db.VarChar(150)
  resource       String   @db.VarChar(80)
  action         String   @db.VarChar(40)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamp(0)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model Address {
  id            String  @id @default(uuid()) @map("address_id") @db.Char(36)
  userId        String  @map("user_id") @db.Char(36)
  recipientName String  @map("recipient_name") @db.VarChar(150)
  phone         String  @db.VarChar(20)
  province      String  @db.VarChar(100)
  ward          String  @db.VarChar(100)
  addressLine   String  @map("address_line") @db.VarChar(255)
  isDefault     Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("address")
}

// Nhật ký kiểm toán DÙNG CHUNG cho mọi miền (đăng ký, đăng nhập, duyệt shop, ...).
// actor_user_id NULL khi hành động do hệ thống thực hiện.
model AuditLog {
  id          String   @id @default(uuid()) @map("audit_log_id") @db.Char(36)
  actorUserId String?  @map("actor_user_id") @db.Char(36)
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.Char(36)
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_log")
}
