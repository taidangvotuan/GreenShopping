model Shop {
  id          String  @id @default(uuid()) @map("shop_id") @db.Char(36)
  ownerId     String  @map("owner_user_id") @db.Char(36)
  name        String  @db.VarChar(150)
  active      Boolean @default(true)
  shippingFee Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 0)

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  products  Product[]
  subOrders SubOrder[]

  @@index([ownerId])
  @@map("shop")
}

model Product {
  id           String  @id @default(uuid()) @map("product_id") @db.Char(36)
  shopId       String  @map("shop_id") @db.Char(36)
  name         String  @db.VarChar(150)
  description  String  @db.Text
  imageUrl     String? @map("image_url") @db.VarChar(500)
  imageGallery Json?   @map("image_gallery")
  price        Decimal @db.Decimal(12, 0)
  stock        Int     @default(0)
  active       Boolean @default(true)

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([shopId])
  @@map("product")
}
