# Môi trường E2E trên MySQL test riêng (docker-compose.test.yml, cổng 127.0.0.1:3308).
# Dùng: cp backend/.env.test.example backend/.env.test
#       node --env-file=.env.test ...   (biến ở process.env được ưu tiên hơn backend/.env)
# ⚠️ Mọi URL ở đây PHẢI trỏ tới 127.0.0.1:3308/greenshopping_test — không bao giờ trỏ vào DB dev (3307).

NODE_ENV=test
PORT=3101
FRONTEND_URL=http://localhost:3000

# Ứng dụng NestJS khi chạy E2E: tài khoản CHỈ DML
DATABASE_URL="mysql://green_test_app:green_test_app_pw@127.0.0.1:3308/greenshopping_test"
# Prisma CLI (migrate deploy/reset/status): tài khoản có DDL — prisma.config.ts đọc biến này
MIGRATION_DATABASE_URL="mysql://green_test_migrate:green_test_migrate_pw@127.0.0.1:3308/greenshopping_test"

# Chỉ dùng cho test (NODE_ENV=test không áp kiểm tra khóa của production)
JWT_ACCESS_SECRET=test_only_jwt_secret_not_for_production_0123456789
JWT_ACCESS_EXPIRES_IN=30m
PASSWORD_SALT=test_only_legacy_password_salt_0001

# E2E kiểm thử luồng thanh toán mô phỏng
PAYMENT_MOCK_ENABLED=true
SEED_DEMO=false
