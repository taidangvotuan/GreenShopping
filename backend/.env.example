# ===== Server =====
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ===== Database (MySQL 8.4 trong docker-compose) =====
# Định dạng: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# SECURITY (VH-01): hai tài khoản tách quyền, tạo bởi docker/mysql/init/01-grant-dev.sql khi volume còn trống:
#   - DATABASE_URL           → ứng dụng NestJS, seed, E2E: tài khoản CHỈ có quyền DML (green_app)
#   - MIGRATION_DATABASE_URL → Prisma CLI (migrate dev/deploy/reset): tài khoản có quyền DDL (green)
# Volume MySQL tạo trước thay đổi này chưa có user green_app → chạy `docker compose down -v` rồi `npm run db:up`.
DATABASE_URL="mysql://green_app:green_app_dev_pw@localhost:3307/green_shopping"
MIGRATION_DATABASE_URL="mysql://green:green_dev_pw@localhost:3307/green_shopping"

# ===== JWT =====
# ⚠️ CẢNH BÁO: giá trị dưới đây là MẪU CÔNG KHAI — bắt buộc thay bằng khóa ngẫu nhiên trước khi chạy ở bất kỳ
# đâu ngoài máy cá nhân. NODE_ENV=production sẽ TỪ CHỐI khởi động nếu JWT_ACCESS_SECRET ngắn hơn 32 ký tự
# hoặc là giá trị mẫu/dễ đoán (change_me_..., secret, jwt_secret, ...). Đổi khóa = mọi phiên cũ mất hiệu lực.
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
# Hạn access token, dạng <số><s|m|h|d>. Mặc định 30m; logout thu hồi token ngay (bảng revoked_token).
JWT_ACCESS_EXPIRES_IN=30m
# Chưa được sử dụng (dành cho luồng refresh token ở giai đoạn sau)
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ===== Lưu file local (ảnh sản phẩm, minh chứng chứng nhận) =====
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# ===== Băm mật khẩu =====
# Mật khẩu mới băm bằng bcrypt (cost 12). PASSWORD_SALT chỉ còn dùng để XÁC MINH hash SHA-256 cũ và tự nâng
# cấp sang bcrypt khi người dùng đăng nhập → KHÔNG đổi giá trị đang dùng khi CSDL còn hash cũ.
PASSWORD_SALT=change_me_password_salt_min_16_chars

# ===== Thanh toán mô phỏng (NV-01) =====
# false (mặc định): POST /api/payments/:orderId/mock-result trả 404 và checkout từ chối phương thức MOCK (403).
# Chỉ đặt true trên máy phát triển hoặc môi trường demo.
PAYMENT_MOCK_ENABLED=false

# ===== Seed (BM-04) =====
# true: `prisma db seed` tạo thêm tài khoản mẫu + cửa hàng/sản phẩm demo. Seed luôn bị chặn khi NODE_ENV=production.
SEED_DEMO=false
